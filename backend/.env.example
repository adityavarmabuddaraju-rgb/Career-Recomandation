# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this to backend/.env and fill in your values

# MongoDB Atlas connection string (get from mongodb.com/atlas)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=careerai

# JWT Secret - change this to a long random string in production!
JWT_SECRET=replace-with-a-very-long-random-secret-string

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# CORS - add your Vercel frontend URL here
# Example: https://career-ai.vercel.app,https://career-ai-git-main.vercel.app
CORS_ORIGINS=["https://your-app.vercel.app"]
