# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
DB_NAME=careerai

# JWT Authentication
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI API Key
GEMINI_API_KEY=
AI_PROVIDER=gemini

# Adzuna Job Search API Credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# File Upload Configuration
UPLOAD_DIR=uploads
