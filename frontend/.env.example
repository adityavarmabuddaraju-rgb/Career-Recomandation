# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values

# Backend API URL - REQUIRED for production (Vercel deployment)
# Set this to your deployed backend URL (e.g. on Render, Railway, Fly.io)
# Example: https://career-ai-backend.onrender.com/api
# Leave empty for local development (uses Vite proxy automatically)
VITE_API_URL=https://your-backend-url.onrender.com/api
